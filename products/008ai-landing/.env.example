# ── 008AI Landing · Vercel 环境变量（部署 008ai.online）─────────────────
# 本文件是本项目唯一的环境变量清单；不要从其他产品复制 Secrets。
# 将下表【必需】变量逐一复制到 Vercel → Settings → Environment Variables，
# 并勾选 Apply to: Production / Preview / Development。
# 占位值请替换为真实密钥；切勿将真实 .env.local / 密钥提交到 git。

# ── 【必需】后台控制面板 /admin 登录密钥 ─────────────────────────────────
# POST /api/admin/login 校验；未配置时回退默认 "008ai-admin"（生产必须显式设置）
ADMIN_KEY=change-me-008ai-admin

# ── 【必需】PayPal 前端 SDK Client ID ────────────────────────────────────
# NEXT_PUBLIC_ 前缀：构建期内联到客户端（PayPalCheckout.tsx 加载 JS SDK）；
# 同时被服务端 create-order / capture-order 回退读取（src/lib/paypal.ts）。
# 从 PayPal Developer Dashboard 获取。
NEXT_PUBLIC_PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_HERE

# ── 【必需】PayPal 服务端密钥（仅服务端使用，切勿泄露）────────────────────
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET_HERE

# ── 【必需·生产推荐】PayPal Webhook ID ───────────────────────────────────
# PayPal Dashboard → Webhooks 创建 Endpoint（URL: https://008ai.online/api/paypal/webhook）
# 事件: PAYMENT.CAPTURE.COMPLETED；用于 webhook 签名校验（PAYPAL_WEBHOOK_ID 预留）。
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID_HERE

# ── 【必需】Hero 演示视频 URL ─────────────────────────────────────────────
# 配置后 Hero 直接渲染 <video>；建议上传 15s MP4（如 /demo.mp4），
# 未配置时显示优雅占位图（推荐配置以完整展示产品演示）。
NEXT_PUBLIC_DEMO_VIDEO_URL=/demo.mp4

# ── 可选：PayPal API 基础地址 ────────────────────────────────────────────
# Sandbox: https://api-m.sandbox.paypal.com | Live: https://api-m.paypal.com
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# ── 可选：服务端 CLIENT ID 别名（默认回退 NEXT_PUBLIC_PAYPAL_CLIENT_ID）──
# 仅在需前后端使用不同 Client ID 时配置；一般无需设置。
# PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_HERE

# ── 【必需】Savage Fit AI 语音教练 · Gemini 3.7 Flash ───────────────────
# /api/savage-fit/chat 主调模型：默认 gemini-3.7-flash（未配置 Key 时返回
# AI_KEY_MISSING，绝不回退 Mock 教练话术）。
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── 可选：覆盖教练模型 / 端点（本地自建端点自动豁免省钱上限）─────────────
# GEMINI_MODEL=gemini-3.7-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ── 【必需】Savage Fit AI · 实时 TTS 语音端点（/api/savage-fit/tts）───────
# 未配置时该路由返回 TTS_UNAVAILABLE（503），前端自动回退浏览器内置语音，
# 绝不回退 Mock 音频。Azure Speech 的 Key 与 Region 二选一填写：
# 优先 TTS_SUBSCRIPTION_KEY / TTS_REGION，兼容 AZURE_SPEECH_KEY / AZURE_SPEECH_REGION。
TTS_SUBSCRIPTION_KEY=YOUR_AZURE_SPEECH_KEY_HERE
TTS_REGION=westus2

# ── 【必需】Savage Cal AI 食物识别桥接（/api/savage-cal/recognize）─────────
# 指向 products/calorieai 已部署的识别端点；未配置时返回
# RECOGNITION_NOT_CONFIGURED（503），本路由不会伪造菜品与热量。
# 例：https://calorieai.example.com/api/v1/meals/analyze-image
CALORIE_AI_API_URL=YOUR_CALORIE_AI_RECOGNITION_ENDPOINT_HERE
CALORIE_AI_API_KEY=YOUR_CALORIE_AI_API_KEY_HERE

# ── 【可选】可穿戴预留接口（/api/wearables/sync，Apple Watch / Garmin）─────
# WEARABLES_WEBHOOK_SECRET 配置后强制校验 x-008ai-signature（请求体的
# HMAC-SHA256 十六进制摘要）；WEARABLES_SYNC_ENABLED=false 时该端点直接 503。
# 当前为契约预留端点：只校验并回显指标，尚未落库。
# WEARABLES_WEBHOOK_SECRET=YOUR_HMAC_SECRET_HERE
# WEARABLES_SYNC_ENABLED=true

# ── 【必需】站点规范域名（NEXT_PUBLIC_SITE_URL）──────────────────────────
# 用于 metadataBase 与 Open Graph url。Vercel Production 建议设为
# https://008ai.online；Preview 可留空或设为预览域名。
# 未配置时回退到 https://008ai.online（与旧版本行为一致）；缺少协议会自动补 https://。
NEXT_PUBLIC_SITE_URL=https://008ai.online
