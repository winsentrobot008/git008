# =============================================================================
# MediaIndexerPro v4 — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Cloud Vision API — DashScope / Alibaba Cloud Model Studio (PAI)
# ---------------------------------------------------------------------------
# Primary: Standard DashScope public endpoint (via dashscope SDK)
#   DASHSCOPE_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#
# OR Custom: OpenAI-compatible private endpoint (e.g. Alibaba Cloud PAI)
#   DASHSCOPE_API_BASE="https://llm-jo2weqcgeqk1wgxi.cn-beijing.maas.aliyuncs.com/v1"
#   DASHSCOPE_API_KEY="your_complete_real_sk_here"
#
# Vision model to use (default: qwen-vl-plus)
# MIP_VISION_MODEL="qwen-vl-plus"
#
# ---------------------------------------------------------------------------
# Fallback: Generic OpenAI-compatible endpoint
# ---------------------------------------------------------------------------
# OPENAI_API_KEY="sk-..."
# OPENAI_ENDPOINT="https://api.openai.com/v1"

# ---------------------------------------------------------------------------
# Media Source APIs
# ---------------------------------------------------------------------------
PEXELS_API_KEY="your_pexels_api_key_here"
PIXABAY_API_KEY="your_pixabay_api_key_here"
MIXKIT_API_KEY=""
YOUTUBE_API_KEY=""

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8001
