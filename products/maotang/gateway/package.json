{
  "name": "@maotang/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "MAOTANG API index gateway: chain RPC reads, the 24h SpendWindow ledger, the ZK-biometric personhood gate and the fail-closed broadcast proxy.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist/test-build/test/*.test.js\"",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@maotang/mobile-agent": "file:../mobile-agent"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}