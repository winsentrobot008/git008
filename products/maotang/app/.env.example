# MAOTANG frontend environment - copy this file to `.env.local` (git-ignored) and fill in a
# deployment. Read by `src/lib/chain.ts` (`readChainConfig`).
#
# Every key here is NEXT_PUBLIC_*: Next.js inlines those into the client bundle at build time, so a
# value placed here is public by definition. Never put a secret in this file.
#
# An empty address is not a broken config: the live panels stay in their deterministic
# "awaiting rpc" state instead of rendering a number nobody can vouch for.

# -- RPC endpoint the board polls ----------------------------------------------------------
# Local anvil (the default dev/testnet chain); start it with `anvil` in `contracts/`.
# The page never posts here directly: a browser read goes through the same-origin `/api/rpc` proxy
# (a cross-origin JSON-RPC call needs CORS headers this endpoint does not send, and the browser logs
# the blocked request even when the JS catches it). This value is what the proxy - and the server-side
# runtime - dials, so it stays the one source of truth for the chain.
NEXT_PUBLIC_MAOTANG_RPC_URL=http://127.0.0.1:8545

# -- Deployment addresses -------------------------------------------------------------------
# Every key below may be left empty: `next.config.ts` forwards the same addresses from
# `app/config/contracts.json` as NEXT_PUBLIC_MANIFEST_* fallbacks, so a build made after a
# deployment binds the live chain without any address being copied here.
#
# `MaoTangFactory` whose launch registry the board walks for live token cards.
NEXT_PUBLIC_MAOTANG_FACTORY_ADDRESS=

# `MaoTangBondingCurve` whose graduation progress the board tracks.
# Legacy alias still accepted: NEXT_PUBLIC_MAOTANG_CURVE
NEXT_PUBLIC_MAOTANG_CURVE_ADDRESS=

# `MaoTangSustenanceVault`: the 0.5% swap / 1.00% graduation fee sink for human sovereign wallets.
# Legacy alias still accepted: NEXT_PUBLIC_MAOTANG_VAULT
NEXT_PUBLIC_MAOTANG_VAULT_ADDRESS=

# `HumanToken` ($mHUMAN) minted by the personhood claim.
NEXT_PUBLIC_MAOTANG_HUMAN_TOKEN_ADDRESS=

# `MaotangFaucetToken` (symbol MAOTANG) and `MaotangFaucet` from the same deployment manifest.
NEXT_PUBLIC_MAOTANG_FAUCET_TOKEN_ADDRESS=
NEXT_PUBLIC_MAOTANG_FAUCET_ADDRESS=

# -- Revenue beneficiaries --------------------------------------------------------------
# EVM operator/developer beneficiary that receives the protocol share of vault yield.
NEXT_PUBLIC_OPERATOR_ADDRESS="0x6aEceB240C902Cc0A52AB7F0eb5bf6B1030077ea"
NEXT_PUBLIC_DEVELOPER_ADDRESS="0x6aEceB240C902Cc0A52AB7F0eb5bf6B1030077ea"
# Developer Bitcoin vault / cross-chain treasury metadata; not an EVM address, shown for routing only.
NEXT_PUBLIC_BTC_REVENUE_ADDRESS="1HBhZ97jHjasVF4XFWLY9Wv8dpNHUq3AbJ"
# -- Web agent console (`src/app/agent`) ----------------------------------------------------
# The console's server-side runtime (`src/lib/agent/runtime.ts`) composes the real M1/M2 modules
# from `@maotang/mobile-agent`. These keys are **server-side** on purpose (no NEXT_PUBLIC_ prefix):
# a spend cap is configuration, not content, and publishing it would invite trust in a number the
# browser could have edited. Every default below is the smaller choice, and the destination and
# selector allow-lists come from the deployment manifest rather than from any of these.

# Inclusive per-transaction cap, in wei. Default 0.1 ETH.
AGENT_POLICY_MAX_VALUE_WEI=100000000000000000
# Inclusive rolling-window cap, in wei. Default 0.5 ETH.
AGENT_POLICY_WINDOW_WEI=500000000000000000
# Rolling window length, in seconds. Default 86400 (24h).
AGENT_POLICY_WINDOW_SECONDS=86400
# Value at or above which the owner's live authorization is required. 0 means every leg. Default 0.
AGENT_POLICY_THRESHOLD_WEI=0
# Extra destinations appended to the manifest pair. Comma-separated; empty by default.
AGENT_POLICY_ALLOW_EXTRA_DESTINATIONS=
# Alias the wallet key lives under inside the enclave.
AGENT_WALLET_KEY_ALIAS=maotang.web.owner
# The M1 stub refuses NODE_ENV=production. Set to 1 only to exercise the wiring on a build that
# knowingly has no real `SlmRuntimeBackend`; the console reports the stub as `kind: "mock"`.
# AGENT_SLM_ALLOW_DETERMINISTIC_IN_PRODUCTION=1

# -- Security hold (server-side, fail-closed) ------------------------------------------------
# Set to 1/true/yes/on (or any unrecognised non-empty value) to halt `/api/agent/intent` and
# `/api/agent/claim` with `503 SECURITY_HALTED` before a body is read. Leave unset, or set to
# 0/false/no/off, for normal operation. The switch never deletes keys or state.
# A Vercel environment change needs a redeploy; use the provider firewall, a rollback or DNS
# controls when containment has to be immediate.
MAOTANG_SECURITY_HOLD=0

# -- WebAuthn / passkey attestation (server-side) ---------------------------------------------
# `MAOTANG_WEBAUTHN_SECRET` seals the enrollment, challenge and personhood cookies (HMAC).
# `MAOTANG_WEBAUTHN_RP_ID` is the relying-party id (the registrable domain); the expected origin
# must match the browser origin exactly. Leave any of them empty to keep every claim route at
# `503 WEBAUTHN_UNCONFIGURED` rather than falling back to a client-supplied verdict.
MAOTANG_WEBAUTHN_SECRET=
MAOTANG_WEBAUTHN_RP_ID=
MAOTANG_WEBAUTHN_EXPECTED_ORIGIN=

# -- Claim ledger / faucet (server-side) ------------------------------------------------------
# The faucet wallet is a mint authority. It is read only by the server claim route; no key is ever
# exposed to the browser. Empty values answer `503 FAUCET_UNCONFIGURED`; the card then shows an
# honest error instead of a pending ticket or a made-up tx hash.
#
# `MaotangFaucetToken` is symbol MAOTANG, 18 decimals, capped at 8.3B whole tokens. Transfers burn
# 0.10% (10 bps), rounded down; the faucet contract is the only address allowed to mint after
# deployment locks the minter.
MAOTANG_FAUCET_RPC_URL=
MAOTANG_FAUCET_CHAIN_ID=
MAOTANG_FAUCET_PRIVATE_KEY=
MAOTANG_FAUCET_TOKEN_ADDRESS=
MAOTANG_FAUCET_CONTRACT_ADDRESS=
MAOTANG_FAUCET_REWARD_UNITS=
MAOTANG_FAUCET_EXPLORER_URL=
MAOTANG_FAUCET_DEFAULT_RECIPIENT=

# -- ERC-4337 Paymaster (server-side) --------------------------------------------------------
# Reads the on-chain 100-operation / 24h window and signs a single-use authorization digest. An
# authorization is not a completed sponsorship: a bundler is still required. Empty values answer
# `configured: false` and `503 PAYMASTER_UNCONFIGURED`.
MAOTANG_PAYMASTER_RPC_URL=
MAOTANG_PAYMASTER_CHAIN_ID=
MAOTANG_PAYMASTER_ENTRY_POINT=
MAOTANG_PAYMASTER_ADDRESS=
MAOTANG_PAYMASTER_EXPLORER_URL=
MAOTANG_PAYMASTER_AUTHORIZER_ADDRESS=
MAOTANG_PAYMASTER_AUTHORIZER_PRIVATE_KEY=

# -- Growth attribution (server-side) --------------------------------------------------------
# Durable aggregate counters, referral tiers and active-user bitmaps use a Redis-compatible REST
# API. Upstash and Vercel KV variable names are also accepted by `src/lib/growth/store.ts`.
# Leave these empty in production to report `configured: false`; never substitute fabricated totals.
MAOTANG_GROWTH_REDIS_REST_URL=
MAOTANG_GROWTH_REDIS_REST_TOKEN=
# Local development may opt into an in-process, reset-on-exit store. Production stays unconfigured
# unless a durable backend is present.
MAOTANG_GROWTH_ALLOW_EPHEMERAL=0
# Comma-separated KOL referral codes. Codes are public link identifiers, never secrets.
MAOTANG_KOL_CODES=
