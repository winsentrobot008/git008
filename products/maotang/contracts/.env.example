# MAOTANG protocol deployment environment - key names only; never a real value in this file.
#
# Copy this file to `contracts/.env` (git-ignored) OR export the values in your shell. Nothing here
# is loaded automatically: `scripts/deploy-testnet.ts` reads `process.env`, and the launcher
# (`scripts/start-alpha.*`) passes its own environment straight through to that process.
#
# The addresses are public data, but a private key is not: DEPLOYER_PRIVATE_KEY and
# MAOTANG_OWNER_PRIVATE_KEY must never reach a commit, a log, a screenshot or an issue body.

# -- Required by scripts/deploy-testnet.ts ---------------------------------------------------
# JSON-RPC endpoint for the target chain. The legacy alias TESTNET_RPC_URL is still accepted.
MAOTANG_TESTNET_RPC_URL=
TESTNET_RPC_URL=
# Funded deployer key. Never logged, never written into the export.
DEPLOYER_PRIVATE_KEY=
# Graduation market: the Uniswap V3 position manager on the target chain.
UNISWAP_V3_POSITION_MANAGER=

# -- Optional: custody and revenue routing ---------------------------------------------------
# Owner of the verifier and the vault. Defaults to the deployer. The contract stores it as an
# `immutable`, so the deployed chain has no ownership-transfer path: pass a Safe or a Timelock in
# production and declare what it is rather than guessing.
MAOTANG_OWNER=
# What the owner is, recorded in the export: eoa | safe | timelock | contract.
MAOTANG_OWNER_TYPE=
# Human-readable label recorded alongside the owner kind.
MAOTANG_OWNER_LABEL=
# Dripper telemetry attestation key. Defaults to the owner.
MAOTANG_TELEMETRY_SIGNER=
# Emergency guardian. Defaults to the owner.
MAOTANG_GUARDIAN=
# Operator/developer EVM beneficiary: receives the protocol share of vault yield (vault + dripper).
MAOTANG_OPERATOR_ADDRESS=
# BTC payout metadata recorded in the export. Not an EVM address; nothing is ever deployed to it.
MAOTANG_BTC_REVENUE_ADDRESS=
# Set to `0` to skip the on-chain 5 ETH graduation-threshold probe.
MAOTANG_REFERENCE_CURVE=

# -- Optional: launcher (`scripts/start-alpha.ps1` / `.sh`) -----------------------------------
# Chain endpoint the launcher reuses instead of spawning its own node.
MAOTANG_RPC_URL=
# Block time and port for the `anvil` the launcher spawns.
ANVIL_BLOCK_TIME=
ANVIL_PORT=
# Private key that signs the three owner-only wiring calls; defaults to the public Anvil
# development key #1 on a loopback chain only.
MAOTANG_OWNER_PRIVATE_KEY=
# Native budget (wei) the owner releases to the dripper during wiring. Default 0.01 ETH.
MAOTANG_DRIP_BUDGET_WEI=
# Registered agent address the video worker attributes proofs to, until a real agent registers.
MAOTANG_AGENT_ID=

# -- Optional: the gateway stage of the launcher ---------------------------------------------
# The gateway's full environment table lives in `gateway/README.md`. The launcher only overrides
# the endpoint it binds the chain to, and the host/port it is probed on.
MAOTANG_GATEWAY_HOST=
MAOTANG_GATEWAY_PORT=
MAOTANG_GATEWAY_RPC_URL=
