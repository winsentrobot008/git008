# MAOTANG frontend production environment (target: https://008ai.online).
# Loaded by Next.js for production builds. Overridden by .env.production.local, then .env.local.
# Every key here is NEXT_PUBLIC_* and therefore public by definition: never put a secret in this file.

# Network & RPC Configuration
NEXT_PUBLIC_CHAIN_ID=31337 # Or target Testnet/Mainnet Chain ID
NEXT_PUBLIC_MAOTANG_RPC_URL="https://rpc.008ai.online" # Or target public RPC URL

# Live deployment addresses. The Factory this board walks, the Vault it tracks and the reference
# Curve are otherwise forwarded from `config/contracts.json` by `next.config.ts` (as
# NEXT_PUBLIC_MANIFEST_*), so only the values that must differ from the manifest belong here.
NEXT_PUBLIC_MAOTANG_FACTORY_ADDRESS="0xa513E6E4b8f2a923D98304ec87F64353C4D5C853"

# Operator & Revenue Beneficiaries
NEXT_PUBLIC_OPERATOR_ADDRESS="0x6aEceB240C902Cc0A52AB7F0eb5bf6B1030077ea"
NEXT_PUBLIC_DEVELOPER_ADDRESS="0x6aEceB240C902Cc0A52AB7F0eb5bf6B1030077ea"
NEXT_PUBLIC_BTC_REVENUE_ADDRESS="1CqDscj8LCx9xXJcxGkSMnwwKVFXbzutDe"
