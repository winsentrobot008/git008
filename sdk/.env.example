# MAOTANG SDK deployment keys - a single reference list for host applications and local scripts.
#
# The SDK reads no environment variables: every address is passed in explicitly
# (`MaoTangClientConfig.factory`, `AgentClientConfig.registry`, ...), which is what keeps it
# dependency-free and safe to bundle. This file records the complete set a host application needs,
# so the frontend / agent-manager templates can be checked against one list.
#
# Copy the values you need into the host application's own env file (e.g. `frontend/.env.local`).
# Nothing here is ever read by `sdk/` itself.

# -- Chain ----------------------------------------------------------------------------------
MAOTANG_RPC_URL=
MAOTANG_CHAIN_ID=

# -- Core protocol --------------------------------------------------------------------------
MAOTANG_FACTORY_ADDRESS=
MAOTANG_CURVE_ADDRESS=
MAOTANG_VAULT_ADDRESS=

# -- Identity, personhood and DePIN mining --------------------------------------------------
MAOTANG_HUMAN_TOKEN_ADDRESS=
MAOTANG_AGENT_REGISTRY_ADDRESS=
MAOTANG_MINING_ADDRESS=
