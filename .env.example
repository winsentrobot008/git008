# 👑 GIT008 工厂 · 环境变量示例（复制为 .env 后填写真实密钥）

# ==========================================
# Active LLM Provider Selection
# Options: "deepseek" | "openrouter" | "siliconflow" | "gemini" | "groq" | "ollama"
# ==========================================
LLM_PROVIDER=siliconflow

# 1. DeepSeek Official
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 2. OpenRouter (Multi-model & Free models)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 3. SiliconFlow (硅基流动 - Qwen & Cheap API)
SILICONFLOW_API_KEY=sk-your_siliconflow_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 4. Google AI Studio (Gemini - Free High Rate Limit)
GEMINI_API_KEY=AIzaSy_your_gemini_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 5. Groq (Ultra-fast Llama & R1 Distill)
GROQ_API_KEY=gsk_your_groq_key
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 6. Ollama (Zero-cost Local LLM)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama  # Dummy key required by OpenAI SDK

# Optional: override the default model of the active provider
# MODEL_NAME=Qwen/Qwen2.5-Coder-32B-Instruct

# ==========================================
# GIT008 集成层 · bb-browser（网络数据感知 / services/crawler）
# ==========================================
# bb-browser 可执行文件；留空自动发现（PATH / npm 全局 shim）
BB_BROWSER_BIN=
BB_BROWSER_DAEMON_HOST=127.0.0.1
BB_BROWSER_DAEMON_PORT=19824
# 未运行 daemon 时是否自动拉起（需可写 ~/.bb-browser 或已有 Chrome CDP 端口）
BB_BROWSER_AUTO_START_DAEMON=true
BB_BROWSER_TIMEOUT=45
BB_BROWSER_OPENCLAW_FALLBACK=false

# ==========================================
# GIT008 集成层 · Computer Use（桌面 GUI 兜底 / services/gui_automation）
# ==========================================
# 总开关：false 时任何桌面操作直接跳过并记录 skip 日志
COMPUTER_USE_ENABLED=false
# auto | pyautogui | powershell | mcp（逗号分隔可组合，按序降级）
COMPUTER_USE_BACKEND=auto
# 允许锁屏/断开/非交互会话下执行（危险，仅无人值守主机开启）
COMPUTER_USE_ALLOW_UNATTENDED=false
# true=只记录动作不注入输入（健康检查 / CI 安全默认）
COMPUTER_USE_DRY_RUN=true
# 外接 Computer Use MCP 插件可执行文件（JSON-RPC stdio，可选）
COMPUTER_USE_MCP_BIN=

# ==========================================
# GIT008 集成层 · Fetch→Process→Publish 流水线（services/pipeline）
# ==========================================
PIPELINE_VIDEO_FACTORY_DIR=products/008-video-factory
PIPELINE_NODE_BIN=
PIPELINE_MOCK_VOICE=false
PIPELINE_NO_PEXELS=true

# ==========================================
# 008 本地视频生产 · ComfyUI + FFmpeg（RTX 3060 12G）
# ==========================================
# ComfyUI 本地服务地址（provider_registry 探测链第一位）
COMFYUI_SERVER_URL=http://127.0.0.1:8188
# 打开本地视频生成（SVD / AnimateDiff 等）
VIDEO_GEN_LOCAL_ENABLED=true
# FFmpeg 可执行文件（务必用 full build：带 NVENC 与 libass）
FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# 可选：强制关闭 NVENC、改用 libx264 软编（默认自动探测）
# FFMPEG_DISABLE_NVENC=0
# 可选：ComfyUI 显存文件锁（跨进程串行化，防 OOM）
# COMFYUI_LOCK_FILE=
# COMFYUI_LOCK_TIMEOUT=3600
