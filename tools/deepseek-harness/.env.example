# ============================================================
# deepseek-harness 子项目配置模板
# 用法：复制为 .env 后填入真实值；.env 已被 .gitignore 忽略。
# 仅登记键名与占位符，严禁把真实密钥写入仓库或提交历史。
# ============================================================

# ------------------------------------------------------------
# 【重要】路由（端点 / 密钥 / 模型 / DSH_HOME）不写在这里！
# dsh 启动时会校验「被发现的 .env」，拒绝其中的 bootstrap 键：
#   - 前缀：DSH_ / XDG_ / DYLD_ / BASH_FUNC_
#   - 名单：DEEPSEEK_BASE_URL、DEEPSEEK_SEARCH_BASE_URL、PATH、HTTP_PROXY 等
# 因此这些键必须写在 config/route.env（由 AI 工厂控制面板自动同步），
# 再由启动脚本经「子进程环境」注入 dsh —— 这是 dsh 允许的唯一通道。
# 参考键名（真实文件：config/route.env，已 gitignore）：
#   DEEPSEEK_BASE_URL=http://127.0.0.1:8001/v1   # 本地网关；云端为 https://api.deepseek.com/v1
#   DEEPSEEK_API_KEY=local
#   DEEPSEEK_CLOUD_API_KEY=                      # 切本地时备份的云端密钥，切回云端时恢复
#   DSH_MODEL=local
#   DSH_HOME=D:/git008/tools/deepseek-harness/config/dsh-home
# ------------------------------------------------------------

# --- 本文件只允许「非 bootstrap」键，例如图形界面（Web UI）的可选项 ---
# WEBUI_PORT=7860            # 监听端口
# WEBUI_HOST=127.0.0.1       # 监听地址
# WEBUI_TIMEOUT=300          # 单次请求超时（秒）
# WEBUI_OPEN_BROWSER=0       # 设为 0 则不自动弹浏览器
# WEBUI_SYSTEM_PROMPT=       # 覆盖默认系统提示词
