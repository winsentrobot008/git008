# ─── SaaS Central Gateway 环境变量 ─────────────────────────────
# 复制为 .env 并填入真实密钥。⚠️ .env 已被 .gitignore 排除，严禁提交。

# 服务端口
PORT=8787

# 套娃应用注册表（APP_ID → GATEWAY_APP_TOKEN 鉴权）：JSON 或 key=value,key=value 两种格式
# 每个套娃前端持有一个独立 App Token（GATEWAY_APP_KEYS / APP_KEYS 为兼容别名）
GATEWAY_APP_TOKENS={"calorieai":"replace_with_calorieai_app_token","petai":"replace_with_petai_app_token"}

# CORS 白名单（仅允许我们自己的套娃前端跨域调用）
CORS_ALLOWED_ORIGINS=https://calorie-ai-seven.vercel.app,https://*.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# 按应用追加 Origin（可选，与全局 CORS_ALLOWED_ORIGINS 合并）
# GATEWAY_APP_ORIGINS={"petai":["https://petai.vercel.app"]}

# ── AI 视觉识别（至少配置一个，A→B→C 回退）──
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_MODEL=openai/gpt-4o-mini
DEEPSEEK_MODEL=deepseek-chat

# ── Stripe 支付（Checkout Session · Credits Top-up 一次性付款，无订阅）──
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── PayPal 支付（订单创建）──
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# ── 跨端积分持久化（可选；默认 os.tmpdir 文件回退）──
# POSTGRES_URL=postgres://user:pass@host:5432/dbname
# KV_REST_API_URL=https://your-region.upstash.io
# KV_REST_API_TOKEN=xxx
